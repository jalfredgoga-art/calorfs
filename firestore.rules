rules_version = '2';
// CalorFS v2 – Reglas de seguridad de Firestore
// Firebase Console > Firestore Database > Reglas > pegar > Publicar.
// El correo de superEmail() debe coincidir con SUPER_ADMIN_EMAIL de index.html.
// Solo se guardan las cuentas de usuario; los reportes se generan en el dispositivo y no se almacenan.
service cloud.firestore {
  match /databases/{database}/documents {

    function superEmail() { return 'jalfred.goga@gmail.com'; }
    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == superEmail(); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function isAdmin() { return signedIn() && exists(userPath()) && me().status == 'aprobado' && me().role == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Registro: todos nacen "usuario/pendiente"; solo el administrador principal nace aprobado.
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'usuario' && request.resource.data.status == 'pendiente') ||
        (isSuper() && request.resource.data.role == 'admin' && request.resource.data.status == 'aprobado')
      );

      // El usuario edita sus datos, nunca su rol, estatus ni correo.
      // Un admin autoriza, suspende y designa admins; nadie salvo él mismo modifica al admin principal.
      allow update: if
        (request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'email']))
        || (isAdmin() && (resource.data.email.lower() != superEmail() || isSuper()));

      allow delete: if isAdmin() && resource.data.email.lower() != superEmail();
    }

    // Todo lo demás queda bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
