{
  "id": "com.fredysafe.calorfs",
  "name": "CalorFS — Índice de Calor",
  "short_name": "CalorFS",
  "description": "Calcula el índice de calor real combinando temperatura y humedad. Previene el golpe de calor con recomendaciones, síntomas y primeros auxilios. NOM-015-STPS. Por FredySafe.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#E87C1E",
  "theme_color": "#E87C1E",
  "orientation": "portrait-primary",
  "lang": "es",
  "dir": "ltr",
  "categories": ["utilities", "tools", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-72.png",  "sizes": "72x72",   "type": "image/png", "purpose": "any" },
